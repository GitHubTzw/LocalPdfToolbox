<Window x:Class="CRTVUP.Unify.LocalPdf.DesktopV2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CRTVUP.Unify.LocalPdf.DesktopV2.Views"
        Title="本地工具箱" Width="1440" Height="920" MinWidth="1180" MinHeight="760"
        Style="{StaticResource {x:Type Window}}" WindowStartupLocation="CenterScreen"
        AllowDrop="True" DragOver="Window_DragOver" DragLeave="Window_DragLeave" Drop="Window_Drop"
        Closing="Window_Closing">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="216" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ============================================ 左侧导航：整块靛蓝渐变 -->
    <Border Background="{StaticResource NavBrush}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 品牌区 -->
        <StackPanel Margin="20,26,20,22">
          <StackPanel Orientation="Horizontal">
            <Border Width="38" Height="38" CornerRadius="10" Background="#33FFFFFF">
              <Image Width="24" Height="24" Source="/LocalPdfV2;component/Assets/app-logo.png" />
            </Border>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="本地工具箱" FontSize="16" FontWeight="SemiBold" Foreground="White" />
              <TextBlock Text="PDF 与开发工具" FontSize="11" Foreground="{StaticResource NavMutedBrush}" Margin="0,2,0,0" />
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <!-- 五个功能区：整行可点，选中项有白色竖条和更亮的底色 -->
        <ListBox Grid.Row="1" x:Name="Nav" BorderThickness="0" Background="Transparent"
                 SelectionChanged="Nav_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 HorizontalContentAlignment="Stretch" Padding="0,4">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="16,13" />
              <Setter Property="Margin" Value="10,2" />
              <Setter Property="Cursor" Value="Hand" />
              <Setter Property="Foreground" Value="{StaticResource NavMutedBrush}" />
              <Setter Property="FontSize" Value="13.5" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Row" Background="Transparent" CornerRadius="9" Padding="{TemplateBinding Padding}">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path x:Name="Icon" Grid.Column="0" Width="18" Height="18" Stretch="Uniform"
                              Fill="{TemplateBinding Foreground}" VerticalAlignment="Center" Margin="0,0,12,0"
                              Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                        <Border x:Name="Marker" Grid.Column="2" Width="3" Height="18" CornerRadius="2"
                                Background="Transparent" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Row" Property="Background" Value="#26FFFFFF" />
                        <Setter Property="Foreground" Value="White" />
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Row" Property="Background" Value="#33FFFFFF" />
                        <Setter TargetName="Marker" Property="Background" Value="White" />
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBoxItem Content="PDF 工作台" Tag="{StaticResource IconFile}" />
          <ListBoxItem Content="JSON / XML" Tag="{StaticResource IconBraces}" />
          <ListBoxItem Content="编码转换" Tag="{StaticResource IconCode}" />
          <ListBoxItem Content="文件对比" Tag="{StaticResource IconCompare}" />
          <ListBoxItem Content="文件压缩" Tag="{StaticResource IconArchive}" />
        </ListBox>

        <!-- 离线声明：固定在最下方，随时可见 -->
        <Border Grid.Row="2" Margin="14,0,14,18" CornerRadius="9" Background="#26FFFFFF" Padding="12,10">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="7" Height="7" Fill="#7BE3A8" VerticalAlignment="Center" />
              <TextBlock Text="离线运行" Foreground="White" FontSize="12" FontWeight="SemiBold" Margin="7,0,0,0" />
            </StackPanel>
            <TextBlock Text="文件只在本机处理，不联网、不上传。" Foreground="{StaticResource NavMutedBrush}"
                       FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="16" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- ============================================ 右侧内容区 -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- 标题条：说明当前功能区，右侧留出各页签自己的主要操作 -->
      <Border Style="{StaticResource SectionHeaderBar}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="HeaderTitle" Style="{StaticResource SectionHeaderTitle}" Text="PDF 工作台" />
            <TextBlock x:Name="HeaderHint" Style="{StaticResource PageHint}" Margin="0,4,0,0"
                       Text="把 PDF 拖进窗口即可开始，列表顺序就是导出顺序。" />
          </StackPanel>
          <ContentControl Grid.Column="1" x:Name="HeaderActions" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <!-- 五个功能区叠放在一起，用可见性切换，避免重建控件树 -->
      <Grid Grid.Row="1" Background="{StaticResource CanvasBrush}">
        <views:PdfTab x:Name="PdfWorkspace" />
        <views:JsonTab x:Name="JsonTools" Visibility="Collapsed" />
        <views:EncodingTab x:Name="EncodingTools" Visibility="Collapsed" />
        <views:DiffTab x:Name="DiffTools" Visibility="Collapsed" />
        <views:CompressTab x:Name="CompressTools" Visibility="Collapsed" />
      </Grid>
    </Grid>

    <!-- ============================================ 拖拽预览浮层 -->
    <Border x:Name="DropOverlay" Grid.ColumnSpan="2" Visibility="Collapsed" Background="#CC1E2130"
            IsHitTestVisible="False">
      <Border Width="460" Padding="34,30" CornerRadius="16" Background="{StaticResource SurfaceBrush}"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border.Effect>
          <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.22" Color="#1E2130" />
        </Border.Effect>
        <StackPanel>
          <Border Width="60" Height="60" CornerRadius="14" Background="{StaticResource AccentSoftBrush}"
                  HorizontalAlignment="Center">
            <Path Width="26" Height="26" Stretch="Uniform" Fill="{StaticResource AccentBrush}"
                  Data="{StaticResource IconPlus}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock x:Name="DropTitle" Text="松开即可导入" FontSize="17" FontWeight="SemiBold"
                     HorizontalAlignment="Center" Margin="0,18,0,0" />
          <TextBlock x:Name="DropDetail" Style="{StaticResource PageHint}" HorizontalAlignment="Center"
                     TextAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap"
                     Text="文件只在本机处理，不会上传。" />
          <Border x:Name="DropPreviewCard" Visibility="Collapsed" Margin="0,18,0,0" CornerRadius="10"
                  Background="{StaticResource SunkenBrush}" BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="1" Padding="12" MaxHeight="260">
            <StackPanel>
              <Image x:Name="DropPreviewImage" MaxHeight="200" Stretch="Uniform" />
              <TextBlock x:Name="DropPreviewCaption" Style="{StaticResource Caption}" HorizontalAlignment="Center"
                         Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
