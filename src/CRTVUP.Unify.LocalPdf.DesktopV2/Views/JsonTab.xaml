<UserControl x:Class="CRTVUP.Unify.LocalPdf.DesktopV2.Views.JsonTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 选项条：标题和说明已由主窗口标题条显示，这里只放格式与缩进选项。 -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,16,24,12">
        <TextBlock Text="格式" Style="{StaticResource FieldLabel}" />
        <ComboBox x:Name="FormatChoice" Width="96" SelectedIndex="0" Margin="0,0,14,0" ToolTip="选择要处理的文本格式">
          <ComboBoxItem Content="JSON" />
          <ComboBoxItem Content="XML" />
        </ComboBox>
        <TextBlock Text="缩进" Style="{StaticResource FieldLabel}" />
        <ComboBox x:Name="IndentChoice" Width="132" SelectedIndex="0" Margin="0,0,14,0" ToolTip="JSON 的缩进方式；XML 固定 2 空格">
          <ComboBoxItem Content="2 空格缩进" />
          <ComboBoxItem Content="4 空格缩进" />
          <ComboBoxItem Content="Tab 缩进" />
        </ComboBox>
      <CheckBox x:Name="SortKeys" Content="按属性名排序" VerticalAlignment="Center" />
    </StackPanel>

    <!-- 操作条：主操作放最左，一眼能看到；互转类操作单独一组。 -->
    <Border Grid.Row="1" Style="{StaticResource ToolbarBar}">
      <WrapPanel>
        <Button Content="格式化" Click="Format_Click" Margin="0,0,6,4" Style="{StaticResource PrimaryButton}" />
        <Button Content="压缩" Click="Minify_Click" Margin="0,0,6,4" />
        <Button Content="校验" Click="Validate_Click" Margin="0,0,6,4" />
        <Button Content="转义" Click="Escape_Click" Margin="0,0,6,4" ToolTip="把文本转成 JSON 字符串转义形式" />
        <Button Content="去转义" Click="Unescape_Click" Margin="0,0,6,4" />
        <Border Style="{StaticResource ToolbarSeparator}" />
        <Button Content="转 XML" Click="ToXml_Click" Margin="0,0,6,4" ToolTip="把 JSON 转成 XML" />
        <Button Content="转 JSON" Click="ToJson_Click" Margin="0,0,6,4" ToolTip="把 XML 转成 JSON" />
        <Button Content="转 CSV" Click="ToCsv_Click" Margin="0,0,6,4" ToolTip="把对象数组转成 CSV 表格" />
        <Button Content="CSV 转 JSON" Click="FromCsv_Click" Margin="0,0,6,4" ToolTip="把 CSV 表格转成对象数组" />
      </WrapPanel>
    </Border>

    <!-- 操作条二：结构查询与数组整理。 -->
    <Grid Grid.Row="2" Margin="24,0,24,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <Button Content="统计结构" Click="Describe_Click" Margin="0,0,6,0" Padding="14,7" ToolTip="统计节点数、最大深度与类型分布" />
        <Button Content="数组去重" Click="Deduplicate_Click" Margin="0,0,6,0" Padding="14,7" />
        <Button Content="数组排序" Click="SortArray_Click" Margin="0,0,6,0" Padding="14,7" />
      </StackPanel>
      <TextBox Grid.Column="1" x:Name="QueryPathBox" Margin="14,0,8,0" Text="data.items[0].name"
               ToolTip="取值路径，支持点号、下标与 * 通配，例如 data.items[0].name" />
      <Button Grid.Column="2" Content="路径提取" Click="Query_Click" Padding="14,7" />
    </Grid>

    <!-- 模型生成：同一份 JSON 可生成多种语言的类型定义。 -->
    <Border Grid.Row="3" Style="{StaticResource NoticeCard}" Margin="24,0,24,12" Padding="14,9">
      <WrapPanel>
        <TextBlock Text="模型生成" Style="{StaticResource SectionTitle}" Margin="0,0,16,0" />
        <TextBlock Text="语言" Style="{StaticResource FieldLabel}" />
        <ComboBox x:Name="ModelLanguage" Width="118" SelectedIndex="0" Margin="0,0,16,0" ToolTip="选择要生成的目标语言">
          <ComboBoxItem Content="C#" />
          <ComboBoxItem Content="TypeScript" />
          <ComboBoxItem Content="Java" />
          <ComboBoxItem Content="Python" />
          <ComboBoxItem Content="Go" />
          <ComboBoxItem Content="SQL" />
        </ComboBox>
        <TextBlock Text="类名" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="ClassNameBox" Width="96" Text="Root" Margin="0,0,16,0" ToolTip="根类型名" />
        <TextBlock Text="命名空间" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="NamespaceBox" Width="300" Text="CRTVUP.BrightBook.BrightBookService.Abstractions.Models" Margin="0,0,16,0"
                 ToolTip="C# 命名空间或 Java 包名；留空则不生成" />
        <TextBlock Text="字符串长度" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="StringLengthBox" Width="62" Text="0" Margin="0,0,16,0" ToolTip="大于 0 时为 C# 字符串属性生成 StringLength 特性" />
        <Button Content="生成模型类" Click="Classes_Click" Padding="16,7" Style="{StaticResource PrimaryButton}" />
      </WrapPanel>
    </Border>

    <Grid Grid.Row="4" Margin="24,0,24,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
          <TextBlock Text="输入" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource IconButton}" Click="LoadFile_Click" ToolTip="从本地文件读取文本">
              <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconFile}" />
            </Button>
            <Button Style="{StaticResource IconButton}" Click="Clear_Click" ToolTip="清空输入和结果">
              <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconTrash}" />
            </Button>
          </StackPanel>
        </Grid>
        <TextBox x:Name="InputBox" Style="{StaticResource MonoBox}" AutomationProperties.Name="输入内容" />
      </DockPanel>
      <GridSplitter Grid.Column="1" Width="12" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" />
      <DockPanel Grid.Column="2">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
          <TextBlock Text="结果" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource IconButton}" Click="UseResult_Click" ToolTip="把结果作为新的输入">
              <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconSwap}" />
            </Button>
            <Button Style="{StaticResource IconButton}" Click="CopyResult_Click" ToolTip="复制结果到剪贴板">
              <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconCopy}" />
            </Button>
            <Button Style="{StaticResource IconButton}" Click="SaveResult_Click" ToolTip="另存为新的本地文本文件">
              <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconExport}" />
            </Button>
          </StackPanel>
        </Grid>
        <TextBox x:Name="ResultBox" Style="{StaticResource MonoBox}" IsReadOnly="True" Background="{StaticResource SunkenBrush}"
                 AutomationProperties.Name="处理结果" />
      </DockPanel>
    </Grid>

    <Border Grid.Row="5" Style="{StaticResource StatusBar}" Margin="0,14,0,0">
      <Grid Margin="20,0" Height="48">
        <TextBlock x:Name="StatusText" Style="{StaticResource StatusTextStyle}" TextWrapping="Wrap"
                   Text="在本机解析和格式化，不上传内容。" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
