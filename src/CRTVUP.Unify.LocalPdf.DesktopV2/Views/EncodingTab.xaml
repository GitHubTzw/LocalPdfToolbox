<UserControl x:Class="CRTVUP.Unify.LocalPdf.DesktopV2.Views.EncodingTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 选项条：标题和说明已由主窗口标题条显示，这里只放字符集与哈希选项。 -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,16,24,12">
        <TextBlock Text="字符集" Style="{StaticResource FieldLabel}" />
        <ComboBox x:Name="CharsetChoice" Width="112" SelectedIndex="0" Margin="0,0,14,0"
                  ToolTip="文本与字节互转时使用的本地代码页">
          <ComboBoxItem Content="UTF-8" />
          <ComboBoxItem Content="GBK" />
          <ComboBoxItem Content="UTF-16 LE" />
          <ComboBoxItem Content="UTF-16 BE" />
          <ComboBoxItem Content="ASCII" />
          <ComboBoxItem Content="Latin-1" />
        </ComboBox>
        <TextBlock Text="哈希" Style="{StaticResource FieldLabel}" />
        <ComboBox x:Name="HashChoice" Width="104" SelectedIndex="2" Margin="0,0,14,0">
          <ComboBoxItem Content="MD5" />
          <ComboBoxItem Content="SHA-1" />
          <ComboBoxItem Content="SHA-256" />
          <ComboBoxItem Content="SHA-512" />
        </ComboBox>
        <CheckBox x:Name="AutoRun" Content="自动转换" IsChecked="True" Margin="0,0,14,0" VerticalAlignment="Center" />
      <CheckBox x:Name="Milliseconds" Content="毫秒时间戳" VerticalAlignment="Center" />
    </StackPanel>

    <!-- 操作条：文本转换与文件操作分成两组，中间用竖线分隔。 -->
    <Border Grid.Row="1" Style="{StaticResource ToolbarBar}">
      <WrapPanel>
        <Button Content="转换" Click="Apply_Click" Margin="0,0,6,4" Style="{StaticResource PrimaryButton}" />
        <Button Content="交换" Click="Swap_Click" Margin="0,0,6,4" ToolTip="把结果作为新的输入" />
        <Border Style="{StaticResource ToolbarSeparator}" />
        <Button Content="文件 → Base64" Click="FileToBase64_Click" Margin="0,0,6,4" />
        <Button Content="Base64 → 新文件" Click="Base64ToFile_Click" Margin="0,0,6,4" />
        <Button Content="计算文件哈希" Click="FileHash_Click" Margin="0,0,6,4" />
        <Button Content="现在的时间戳" Click="Now_Click" Margin="0,0,6,4" />
      </WrapPanel>
    </Border>

    <!-- 参数条：随所选转换方式显示需要的输入，不需要参数时整行隐藏。 -->
    <Border x:Name="ParamBar" Grid.Row="2" Style="{StaticResource NoticeCard}" Margin="24,0,24,12" Padding="14,9"
            Visibility="Collapsed">
      <WrapPanel>
        <TextBlock Text="参数" Style="{StaticResource SectionTitle}" Margin="0,0,16,0" />
        <TextBlock x:Name="Param1Label" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="Param1Box" Width="220" Margin="0,0,16,0" />
        <TextBlock x:Name="Param2Label" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="Param2Box" Width="140" Margin="0,0,16,0" />
        <TextBlock x:Name="Param3Label" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="Param3Box" Width="140" />
      </WrapPanel>
    </Border>

    <Grid Grid.Row="3" Margin="24,0,24,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="238" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Background="{StaticResource SunkenBrush}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <TextBlock Text="转换方式" Style="{StaticResource SectionTitle}" Margin="12,11,12,7" />
          <ListBox Grid.Row="1" x:Name="OperationList" BorderThickness="0" Background="Transparent" Padding="5"
                   SelectionChanged="Operation_Changed" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   HorizontalContentAlignment="Stretch">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="10,7" />
                <Setter Property="Margin" Value="0,0,0,2" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="Row" Padding="{TemplateBinding Padding}" CornerRadius="6" Background="Transparent">
                        <ContentPresenter />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource RowHoverBrush}" /></Trigger>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter TargetName="Row" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                          <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
          </ListBox>
        </Grid>
      </Border>
      <Grid Grid.Column="1" Margin="14,0,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="输入" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
          <TextBox x:Name="InputBox" Style="{StaticResource MonoBox}" TextChanged="Input_Changed" AutomationProperties.Name="输入内容" />
        </DockPanel>
        <GridSplitter Grid.Row="1" Height="12" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent" />
        <DockPanel Grid.Row="2">
          <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
            <TextBlock Text="结果" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Style="{StaticResource IconButton}" Click="CopyResult_Click" ToolTip="复制结果到剪贴板">
                <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconCopy}" />
              </Button>
              <Button Style="{StaticResource IconButton}" Click="SaveResult_Click" ToolTip="另存为新的本地文件">
                <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconExport}" />
              </Button>
              <Button Style="{StaticResource IconButton}" Click="Clear_Click" ToolTip="清空输入和结果">
                <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconTrash}" />
              </Button>
            </StackPanel>
          </Grid>
          <TextBox x:Name="ResultBox" Style="{StaticResource MonoBox}" IsReadOnly="True" Background="{StaticResource SunkenBrush}"
                   AutomationProperties.Name="转换结果" />
        </DockPanel>
      </Grid>
    </Grid>

    <Border Grid.Row="4" Style="{StaticResource StatusBar}" Margin="0,14,0,0">
      <Grid Margin="20,0" Height="48">
        <TextBlock x:Name="StatusText" Style="{StaticResource StatusTextStyle}" TextWrapping="Wrap"
                   Text="所有转换都在本机完成，不上传内容。" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
