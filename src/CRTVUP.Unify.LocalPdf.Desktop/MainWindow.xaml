<Window x:Class="CRTVUP.Unify.LocalPdf.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="本地 PDF 工作台" Width="1240" Height="820" MinWidth="1080" MinHeight="680" Style="{StaticResource {x:Type Window}}"
        WindowStartupLocation="CenterScreen" AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop" Closing="Window_Closing">
  <Grid Background="#F5F7F6">
    <Grid.RowDefinitions><RowDefinition Height="88" /><RowDefinition Height="*" /><RowDefinition Height="68" /></Grid.RowDefinitions>
    <Border Background="White" BorderBrush="#E1E8E4" BorderThickness="0,0,0,1">
      <Grid Margin="28,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Image Width="52" Height="52" Source="/LocalPdf;component/Assets/app-logo.png" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0">
          <TextBlock Text="本地 PDF 工作台" FontSize="23" FontWeight="SemiBold" />
          <TextBlock Text="合并文档 · 内容编辑 · 本地转换" Foreground="#74867E" Margin="0,4,0,0" FontSize="12" />
        </StackPanel>
        <Border Grid.Column="2" Background="#EAF5EF" CornerRadius="16" Padding="14,7" VerticalAlignment="Center"><TextBlock Text="●  离线运行 · 无水印" Foreground="#186A57" FontSize="12" /></Border>
      </Grid>
    </Border>
    <Grid Grid.Row="1" x:Name="WorkspaceArea">
      <Grid.ColumnDefinitions><ColumnDefinition Width="235" /><ColumnDefinition Width="*" /><ColumnDefinition Width="310" /></Grid.ColumnDefinitions>
      <Border BorderBrush="#E1E8E4" BorderThickness="0,0,1,0" Background="#F9FBFA">
        <Grid Margin="20,23,20,20">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="01  添加文档" FontSize="15" FontWeight="SemiBold" /><TextBlock Text="可添加多个 PDF，或拖入窗口" Foreground="#74867E" FontSize="11" Margin="0,7,0,17" /></StackPanel>
          <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <Button Content="＋  添加 PDF" Style="{StaticResource PrimaryButton}" Click="AddFiles_Click" Padding="12,11" Margin="0,0,0,9" />
            <Button Content="⇄  格式转换" Click="Convert_Click" Padding="12,10" ToolTip="PDF 导出为图片、文字或 Office；图片和 Office 文字转 PDF" />
          </StackPanel>
          <ListBox Grid.Row="2" x:Name="SourceList" ItemsSource="{Binding Sources}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,8" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate><DataTemplate>
              <Border Padding="11" CornerRadius="8" Background="White" BorderBrush="#E0E8E3" BorderThickness="1">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}" FontWeight="SemiBold" FontSize="12" /><TextBlock Text="{Binding Description}" Foreground="#7A8D83" FontSize="11" Margin="0,6,0,0" /></StackPanel>
                  <Button Grid.Column="1" Content="×" Click="RemoveSource_Click" Tag="{Binding Id}" Padding="5,1" BorderThickness="0" Background="Transparent" Foreground="#7A8D83" ToolTip="移除此文档及对应页面" Margin="4,0,0,0" VerticalAlignment="Top" />
                </Grid>
              </Border>
            </DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Grid.Row="3">
            <Button Content="清空本次工作" Click="Clear_Click" Margin="0,12,0,13" FontSize="12" />
            <Border Background="#EDF3EF" CornerRadius="8" Padding="12"><TextBlock Text="文件仅在本机处理。&#x0a;不上传，不保存使用历史。&#x0a;关闭窗口即可结束本次会话。" FontSize="11" Foreground="#60786B" TextWrapping="Wrap" LineHeight="20" /></Border>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Column="1" Margin="22,23,20,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="02  整理页面" FontSize="16" FontWeight="SemiBold" /><TextBlock x:Name="PageSummary" Grid.Column="1" Foreground="#74867E" VerticalAlignment="Center" FontSize="12" Text="0 页" /></Grid>
        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
          <Button x:Name="EditContentButton" Content="编辑内容" Click="EditContent_Click" Padding="10,7" Margin="0,0,6,6" Foreground="#186A57" ToolTip="选择一页，编辑其中的文字、图片或标记" />
          <Button Content="全选" Click="SelectAll_Click" Padding="10,7" Margin="0,0,6,6" />
          <Button Content="上移" Click="MoveUp_Click" Padding="10,7" Margin="0,0,6,6" ToolTip="保持所选页面之间的顺序，整体前移" />
          <Button Content="下移" Click="MoveDown_Click" Padding="10,7" Margin="0,0,6,6" />
          <Button Content="旋转 90°" Click="Rotate_Click" Padding="10,7" Margin="0,0,6,6" />
          <Button Content="删除" Click="Delete_Click" Padding="10,7" Margin="0,0,6,6" Foreground="#A34539" />
          <Button x:Name="UndoButton" Content="撤销" Click="Undo_Click" Padding="10,7" Margin="0,0,0,6" IsEnabled="False" />
        </WrapPanel>
        <Grid Grid.Row="2" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBox x:Name="PageRangeBox" ToolTip="按当前输出页序选择，例如 1-3,5；页码从 1 开始" KeyDown="PageRange_KeyDown" AutomationProperties.Name="选择页码" />
          <Button Grid.Column="1" Content="按页码选中" Click="SelectRange_Click" Margin="7,0,0,0" Padding="10,6" />
          <Button Grid.Column="2" Content="仅保留选中" Click="KeepSelected_Click" Margin="7,0,0,0" Padding="10,6" />
        </Grid>
        <Border Grid.Row="3" Background="White" BorderBrush="#E0E8E3" BorderThickness="1" CornerRadius="10">
          <Grid>
            <ListBox x:Name="PageList" ItemsSource="{Binding Pages}" Background="Transparent" BorderThickness="0" SelectionMode="Extended" SelectionChanged="PageList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" HorizontalContentAlignment="Stretch" Padding="7">
              <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="10" /><Setter Property="Margin" Value="0,0,0,3" />
                <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="1" />
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#F4F8F5" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#EAF5EF" /><Setter TargetName="Row" Property="BorderBrush" Value="#A7CFBB" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
              </Style></ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate><DataTemplate>
                <Grid MinHeight="47"><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="43" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <CheckBox VerticalAlignment="Center" IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=TwoWay}" ToolTip="选择此页" Focusable="False" />
                  <Border Grid.Column="1" Width="30" Height="39" CornerRadius="3" Background="#F7FAF8" BorderBrush="#CDDBD2" BorderThickness="1" HorizontalAlignment="Left"><TextBlock Text="{Binding Position}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#537663" /></Border>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding FileName}" FontSize="12" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding OriginalPageLabel}" Foreground="#7A8D83" FontSize="11" Margin="0,5,0,0" /></StackPanel>
                  <TextBlock Grid.Column="3" Text="{Binding RotationLabel}" FontSize="11" Foreground="#52745F" VerticalAlignment="Center" Margin="10,0,0,0" />
                </Grid>
              </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="25" IsHitTestVisible="False">
              <Border Width="68" Height="83" CornerRadius="8" BorderBrush="#C4D7CA" BorderThickness="2" Background="#F7FAF8" HorizontalAlignment="Center" Margin="0,0,0,20"><TextBlock Text="＋" Foreground="#85A590" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
              <TextBlock Text="把需要合并的 PDF 放到这里" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock Text="支持选择页码、调整顺序、删除和旋转" FontSize="12" Foreground="#829489" Margin="0,9,0,0" HorizontalAlignment="Center" />
            </StackPanel>
          </Grid>
        </Border>
        <TextBlock Grid.Row="4" Text="列表顺序就是导出顺序。Ctrl / Shift 可多选；页码示例：1-3,5。" Foreground="#7A8D83" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap" />
      </Grid>
      <Border Grid.Column="2" Background="#EFF3F0" BorderBrush="#E0E8E3" BorderThickness="1,0,0,0">
        <Grid Margin="20,24,20,18"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Grid Margin="0,0,0,18"><TextBlock Text="页面预览" FontSize="14" FontWeight="SemiBold" /><TextBlock x:Name="PreviewPosition" HorizontalAlignment="Right" Foreground="#7A8D83" FontSize="12" /></Grid>
          <Border Grid.Row="1" Background="#E4EBE6" CornerRadius="8" Padding="14" MinHeight="200">
            <Grid><Image x:Name="PreviewImage" Stretch="Uniform" SnapsToDevicePixels="True" ToolTip="双击放大预览" MouseLeftButtonDown="PreviewImage_MouseLeftButtonDown" /><TextBlock x:Name="PreviewPlaceholder" Text="选择一页，即可查看预览" Foreground="#7C9383" TextAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" /></Grid>
          </Border>
          <TextBlock Grid.Row="2" x:Name="PreviewCaption" Foreground="#6D8475" TextWrapping="Wrap" FontSize="11" Margin="0,12,0,18" MinHeight="18" />
          <StackPanel Grid.Row="3"><TextBlock Text="03  保存新文档" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="不修改原文件，不添加水印。&#x0a;请选择不自动同步的本地文件夹。" TextWrapping="Wrap" Foreground="#7A8D83" FontSize="11" LineHeight="19" Margin="0,8,0,0" /></StackPanel>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Row="2" Background="White" BorderBrush="#E1E8E4" BorderThickness="0,1,0,0">
      <Grid Margin="26,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center"><TextBlock x:Name="StatusText" Text="准备就绪，请添加 PDF。" FontSize="12" TextTrimming="CharacterEllipsis" /><ProgressBar x:Name="BusyProgress" IsIndeterminate="True" Height="3" Visibility="Collapsed" Margin="0,7,25,0" Foreground="{StaticResource Accent}" /></StackPanel>
        <Button Grid.Column="1" x:Name="CancelButton" Content="取消" Click="Cancel_Click" Visibility="Collapsed" Margin="12,0" VerticalAlignment="Center" />
        <Button Grid.Column="2" x:Name="ExportButton" Content="合并并导出 PDF  →" Style="{StaticResource PrimaryButton}" Padding="24,12" VerticalAlignment="Center" Click="Export_Click" IsEnabled="False" />
      </Grid>
    </Border>
  </Grid>
</Window>
