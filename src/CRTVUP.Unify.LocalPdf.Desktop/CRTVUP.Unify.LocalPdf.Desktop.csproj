<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>LocalPdf</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Description>纯本地 PDF 内容编辑、页面整理与文件转换工具</Description>
    <Version>2.0.0</Version>
    <ApplicationIcon>../../assets/app.ico</ApplicationIcon>
    <!-- 发布时只从同目录 runtime 加载本地运行库；不搜索注册表或尝试安装运行时。 -->
    <AppHostDotNetSearch Condition="'$(BundleLocalRuntime)' == 'true'">AppRelative</AppHostDotNetSearch>
    <AppHostRelativeDotNet Condition="'$(BundleLocalRuntime)' == 'true'">runtime</AppHostRelativeDotNet>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../CRTVUP.Unify.LocalPdf.Implement/CRTVUP.Unify.LocalPdf.Implement.csproj" />
    <Resource Include="../../assets/app-logo.png" Link="Assets/app-logo.png" />
    <Resource Include="../../assets/app.ico" Link="Assets/app.ico" />
    <Content Include="../../vendor/pdfium/pdfium.dll" Link="pdfium.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../vendor/licenses/**/*" Link="licenses/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
