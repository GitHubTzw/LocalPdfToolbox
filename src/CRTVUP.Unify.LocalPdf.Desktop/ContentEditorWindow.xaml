<Window x:Class="CRTVUP.Unify.LocalPdf.Desktop.ContentEditorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="编辑 PDF 内容" Width="1380" Height="900" MinWidth="1100" MinHeight="720"
 Style="{StaticResource {x:Type Window}}" WindowStartupLocation="CenterOwner" Closing="Editor_Closing">
 <Window.Resources>
  <!-- 顶部工具：整组互斥，选中项用强调色实心块表示当前模式。 -->
  <Style x:Key="ToolToggle" TargetType="RadioButton">
   <Setter Property="Padding" Value="14,9" />
   <Setter Property="Margin" Value="0,0,4,0" />
   <Setter Property="Cursor" Value="Hand" />
   <Setter Property="Foreground" Value="#3A4256" />
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="RadioButton">
      <Border x:Name="Chip" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
       <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Chip" Property="Background" Value="#EEF0FE" />
       </Trigger>
       <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="Chip" Property="Background" Value="#6C71ED" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="PanelTitle" TargetType="TextBlock">
   <Setter Property="FontWeight" Value="SemiBold" />
   <Setter Property="FontSize" Value="13.5" />
   <Setter Property="Foreground" Value="#1E2130" />
  </Style>
  <Style x:Key="PanelHint" TargetType="TextBlock">
   <Setter Property="Foreground" Value="#6E7488" />
   <Setter Property="FontSize" Value="11.5" />
   <Setter Property="TextWrapping" Value="Wrap" />
   <Setter Property="LineHeight" Value="17" />
  </Style>
 </Window.Resources>
 <Grid Background="#F6F8FA">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto" />
   <RowDefinition Height="*" />
   <RowDefinition Height="Auto" />
  </Grid.RowDefinitions>

  <!-- ============================================ 顶部：标题 + 工具 + 保存 -->
  <Border Background="White" BorderBrush="#E6E8F0" BorderThickness="0,0,0,1" Padding="22,14">
   <Grid>
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="Auto" />
     <ColumnDefinition Width="*" />
     <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center" Margin="0,0,26,0">
     <TextBlock Text="编辑页面内容" FontSize="17" FontWeight="SemiBold" Foreground="#1E2130" />
     <TextBlock x:Name="PageLabel" Foreground="#6E7488" Margin="0,4,0,0" FontSize="11.5" />
    </StackPanel>

    <!-- 工具组：选择 / 文字 / 图片 / 高亮 / 画框 -->
    <Border Grid.Column="1" Background="#F3F5F9" CornerRadius="10" Padding="4" HorizontalAlignment="Left"
            VerticalAlignment="Center">
     <StackPanel Orientation="Horizontal">
      <RadioButton x:Name="ToolSelect" Style="{StaticResource ToolToggle}" GroupName="EditorTool" IsChecked="True"
                   Content="选择" Checked="ToolSelect_Checked" ToolTip="点页面上的文字、图片或图形进行编辑（Esc 可随时回到此模式）" />
      <RadioButton x:Name="ToolText" Style="{StaticResource ToolToggle}" GroupName="EditorTool"
                   Content="插入文字" Checked="ToolText_Checked" ToolTip="在页面上单击文字起点" />
      <RadioButton x:Name="ToolImage" Style="{StaticResource ToolToggle}" GroupName="EditorTool"
                   Content="插入图片" Checked="ToolImage_Checked" ToolTip="在页面上拖出放置范围，图片保持比例" />
      <RadioButton x:Name="ToolHighlight" Style="{StaticResource ToolToggle}" GroupName="EditorTool"
                   Content="高亮" Checked="ToolHighlight_Checked" ToolTip="在页面上拖出高亮范围" />
      <RadioButton x:Name="ToolRect" Style="{StaticResource ToolToggle}" GroupName="EditorTool"
                   Content="画框" Checked="ToolRect_Checked" ToolTip="在页面上拖出矩形边框" />
     </StackPanel>
    </Border>

    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
     <Button x:Name="EditorUndo" Content="撤销" Click="UndoEdit_Click" IsEnabled="False" Margin="0,0,8,0" />
     <Button x:Name="CancelEdit" Content="取消" Click="CancelEdit_Click" Margin="0,0,8,0" />
     <Button x:Name="SaveEdit" Content="保存到工作区" Style="{StaticResource PrimaryButton}" Click="SaveEdit_Click" />
    </StackPanel>
   </Grid>
  </Border>

  <!-- ============================================ 主体：大预览 + 右侧属性 -->
  <Grid Grid.Row="1" x:Name="EditorArea" Margin="22,18,22,16">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*" />
    <ColumnDefinition Width="Auto" />
    <ColumnDefinition Width="330" />
   </Grid.ColumnDefinitions>

   <!-- 预览：整页原样显示，直接在上面点选 -->
   <Grid>
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto" />
     <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Border Background="#EEF0FE" CornerRadius="9" Padding="14,10" Margin="0,0,0,12">
     <StackPanel Orientation="Horizontal">
      <Ellipse Width="7" Height="7" Fill="#6C71ED" VerticalAlignment="Center" />
      <TextBlock x:Name="ModeHint" Text="选择对象：单击文字、图片或图形" TextWrapping="Wrap" Foreground="#4A4FB8"
                 Margin="9,0,0,0" VerticalAlignment="Center" />
     </StackPanel>
    </Border>
    <Border Grid.Row="1" Background="#E9EBF3" CornerRadius="12" Padding="18">
     <Viewbox Stretch="Uniform">
      <Grid x:Name="PageSurface" Width="600" Height="800" Background="White">
       <Image x:Name="PageImage" Stretch="Fill" />
       <Canvas x:Name="SelectionLayer" Background="Transparent" MouseLeftButtonDown="Surface_Down"
               MouseMove="Surface_Move" MouseLeftButtonUp="Surface_Up" />
      </Grid>
     </Viewbox>
    </Border>
   </Grid>

   <GridSplitter Grid.Column="1" Width="18" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                 Background="Transparent" />

   <!-- 右侧属性面板：选中什么就改什么 -->
   <Border Grid.Column="2" Background="White" BorderBrush="#E6E8F0" BorderThickness="1" CornerRadius="12">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel Margin="18">
      <TextBlock Text="当前选中" Style="{StaticResource PanelTitle}" />
      <TextBlock x:Name="ObjectHint" Style="{StaticResource PanelHint}" Margin="0,7,0,0"
                 Text="尚未选择对象。在左侧页面上单击文字、图片或图形即可选中。" />

      <Border Background="#F3F5F9" CornerRadius="9" Padding="13" Margin="0,16,0,0">
       <StackPanel>
        <TextBlock Text="文字内容" Style="{StaticResource PanelTitle}" />
        <TextBox x:Name="ContentTextBox" Height="104" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,9,0,0"
                 VerticalScrollBarVisibility="Auto" MaxLength="32768" AutomationProperties.Name="编辑文字"
                 ToolTip="选中文字对象后，在这里改内容再点“替换选中文字”" />
        <Grid Margin="0,10,0,0">
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="72" />
          <ColumnDefinition Width="88" />
         </Grid.ColumnDefinitions>
         <ComboBox x:Name="FontChoice" SelectedIndex="0" Padding="5"
                   ToolTip="替换时使用本机字体，不联网加载字体">
          <ComboBoxItem Content="自动字体" />
          <ComboBoxItem Content="黑体" />
          <ComboBoxItem Content="Arial" />
         </ComboBox>
         <TextBox x:Name="FontSizeInput" Grid.Column="1" Text="16" Margin="7,0" ToolTip="字号（点）" />
         <ComboBox x:Name="ColorChoice" Grid.Column="2" SelectedIndex="0" Padding="4">
          <ComboBoxItem Content="原色" />
          <ComboBoxItem Content="黑色" />
          <ComboBoxItem Content="红色" />
          <ComboBoxItem Content="蓝色" />
          <ComboBoxItem Content="绿色" />
         </ComboBox>
        </Grid>
        <Button x:Name="ReplaceTextButton" Content="替换选中文字" Click="ReplaceText_Click" Margin="0,10,0,0" />
       </StackPanel>
      </Border>

      <Border Background="#F3F5F9" CornerRadius="9" Padding="13" Margin="0,12,0,0">
       <StackPanel>
        <TextBlock Text="图片" Style="{StaticResource PanelTitle}" />
        <TextBlock Style="{StaticResource PanelHint}" Margin="0,7,0,0"
                   Text="替换会按原位置和比例放入新图片；插入时在页面上拖出范围。" />
        <Button x:Name="ReplaceImageButton" Content="替换选中图片" Click="ReplaceImage_Click" Margin="0,10,0,0" />
        <Button Content="插入图片（在页面上拖出范围）" Click="InsertImage_Click" Margin="0,8,0,0" />
       </StackPanel>
      </Border>

      <Border Background="#F3F5F9" CornerRadius="9" Padding="13" Margin="0,12,0,0">
       <StackPanel>
        <TextBlock Text="标记" Style="{StaticResource PanelTitle}" />
        <TextBlock Style="{StaticResource PanelHint}" Margin="0,7,0,0"
                   Text="换到“高亮”或“画框”工具后，在页面上拖出范围即可添加。" />
        <Grid Margin="0,10,0,0">
         <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition />
         </Grid.ColumnDefinitions>
         <Button Content="拖动高亮" Click="Highlight_Click" Margin="0,0,4,0" />
         <Button Grid.Column="1" Content="拖动画框" Click="Rectangle_Click" Margin="4,0,0,0" />
        </Grid>
       </StackPanel>
      </Border>

      <Button x:Name="DeleteObjectButton" Content="删除选中对象" Click="DeleteObject_Click" Margin="0,14,0,0"
              Foreground="#C0392B" />

      <TextBlock x:Name="PageWarnings" Style="{StaticResource PanelHint}" Margin="0,16,0,0" />
     </StackPanel>
    </ScrollViewer>
   </Border>
  </Grid>

  <!-- ============================================ 状态栏 -->
  <Border Grid.Row="2" Background="White" BorderBrush="#E6E8F0" BorderThickness="0,1,0,0">
   <Grid Margin="22,0" Height="54">
    <TextBlock x:Name="EditorStatus" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12"
               Foreground="#6E7488"
               Text="修改先保留在本次编辑中；保存后仍需在主窗口导出 PDF。" />
   </Grid>
  </Border>
 </Grid>
</Window>
