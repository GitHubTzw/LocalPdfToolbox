<Window x:Class="CRTVUP.Unify.LocalPdf.Desktop.ContentEditorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="编辑 PDF 内容" Width="1220" Height="840" MinWidth="980" MinHeight="680"
 Style="{StaticResource {x:Type Window}}" WindowStartupLocation="CenterOwner" Closing="Editor_Closing">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="64"/></Grid.RowDefinitions>
  <Border Background="White" BorderBrush="#DCE5E1" BorderThickness="0,0,0,1" Padding="24,16">
   <StackPanel><TextBlock Text="编辑页面内容" FontSize="21" FontWeight="SemiBold"/>
    <TextBlock x:Name="PageLabel" Foreground="#74867E" Margin="0,5,0,0" FontSize="12"/></StackPanel>
  </Border>
  <Grid Grid.Row="1" x:Name="EditorArea">
   <Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="White" BorderBrush="#DCE5E1" BorderThickness="0,0,1,0">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel Margin="20,18">
      <TextBlock Text="页面对象" FontWeight="SemiBold" FontSize="14"/>
      <TextBlock Text="点击页面上的对象，或从列表选择" Foreground="#74867E" FontSize="11" Margin="0,6,0,8"/>
      <Button Content="选择对象 / 退出绘制（Esc）" Click="SelectMode_Click" Margin="0,0,0,8" Padding="8,6"/>
      <ListBox x:Name="ObjectList" Height="148" BorderBrush="#DCE5E1" DisplayMemberPath="Label" SelectionChanged="ObjectList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
      <TextBlock x:Name="ObjectHint" TextWrapping="Wrap" Foreground="#946A27" FontSize="11" Margin="0,8,0,10"/>
      <TextBlock Text="文字内容" FontWeight="SemiBold" Margin="0,0,0,6"/>
      <TextBox x:Name="ContentTextBox" Height="96" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="32768" AutomationProperties.Name="编辑文字"/>
      <Grid Margin="0,9,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
       <ComboBox x:Name="FontChoice" SelectedIndex="0" Padding="5" ToolTip="替换时使用本机字体，不联网加载字体"><ComboBoxItem Content="自动字体"/><ComboBoxItem Content="黑体"/><ComboBoxItem Content="Arial"/></ComboBox>
       <TextBox x:Name="FontSizeInput" Grid.Column="1" Text="16" Margin="7,0" ToolTip="字号（点）"/>
       <ComboBox x:Name="ColorChoice" Grid.Column="2" SelectedIndex="0" Padding="4"><ComboBoxItem Content="原色"/><ComboBoxItem Content="黑色"/><ComboBoxItem Content="红色"/><ComboBoxItem Content="蓝色"/><ComboBoxItem Content="绿色"/></ComboBox>
      </Grid>
      <Button x:Name="ReplaceTextButton" Content="替换选中文字" Click="ReplaceText_Click" Margin="0,0,0,8"/>
      <Button Content="插入文字 → 点击页面位置" Click="InsertText_Click" Margin="0,0,0,8"/>
      <TextBlock Text="图片与标记" FontWeight="SemiBold" Margin="0,8,0,9"/>
      <Button x:Name="ReplaceImageButton" Content="替换选中图片" Click="ReplaceImage_Click" Margin="0,0,0,8"/>
      <Button Content="插入图片 → 拖出放置范围" Click="InsertImage_Click" Margin="0,0,0,8"/>
      <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Button Content="拖动高亮" Click="Highlight_Click" Margin="0,0,4,0"/><Button Grid.Column="1" Content="拖动画框" Click="Rectangle_Click" Margin="4,0,0,0"/>
      </Grid>
      <Button x:Name="DeleteObjectButton" Content="删除选中对象" Click="DeleteObject_Click" Foreground="#A34539"/>
      <TextBlock x:Name="PageWarnings" TextWrapping="Wrap" Foreground="#74867E" FontSize="11" LineHeight="18" Margin="0,15,0,0"/>
     </StackPanel>
    </ScrollViewer>
   </Border>
   <Grid Grid.Column="1" Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="#E9F2ED" CornerRadius="7" Padding="12,9" Margin="0,0,0,13"><TextBlock x:Name="ModeHint" Text="选择对象：单击文字、图片或图形" TextWrapping="Wrap" Foreground="#186A57"/></Border>
    <Border Grid.Row="1" Background="#E2EAE5" CornerRadius="9" Padding="15">
     <Viewbox Stretch="Uniform">
      <Grid x:Name="PageSurface" Width="600" Height="800" Background="White">
       <Image x:Name="PageImage" Stretch="Fill"/>
       <Canvas x:Name="SelectionLayer" Background="Transparent" MouseLeftButtonDown="Surface_Down" MouseMove="Surface_Move" MouseLeftButtonUp="Surface_Up"/>
      </Grid>
     </Viewbox>
    </Border>
   </Grid>
  </Grid>
  <Border Grid.Row="2" Background="White" BorderBrush="#DCE5E1" BorderThickness="0,1,0,0">
   <Grid Margin="22,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="EditorStatus" Text="修改先保留在本次编辑中；保存后仍需在主窗口导出 PDF。" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12" Margin="0,0,14,0"/>
    <Button x:Name="EditorUndo" Grid.Column="1" Content="撤销内容修改" Click="UndoEdit_Click" IsEnabled="False" Margin="0,0,8,0" VerticalAlignment="Center"/>
    <Button x:Name="CancelEdit" Grid.Column="2" Content="取消" Click="CancelEdit_Click" Margin="0,0,8,0" VerticalAlignment="Center"/>
    <Button x:Name="SaveEdit" Grid.Column="3" Content="保存到工作区" Style="{StaticResource PrimaryButton}" Click="SaveEdit_Click" VerticalAlignment="Center"/>
   </Grid>
  </Border>
 </Grid>
</Window>
